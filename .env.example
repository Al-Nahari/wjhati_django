# Django
DJANGO_SECRET_KEY=supersecretkey
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL
POSTGRES_DB=project_db
POSTGRES_USER=myproject_user
POSTGRES_PASSWORD=myproject_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# OneSignal (احصل عليها من لوحة تحكم OneSignal بعد إبطال المفتاح القديم المسرّب)
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Firebase Admin SDK — مسار ملف مفتاح حساب الخدمة على الخادم (لا تضع الملف في git)
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase_admin_sdk.json

# CORS — قائمة النطاقات المسموح لها بإرسال طلبات موثّقة (مفصولة بفواصل)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
